# ==========================================
# RepoMind / RepoAsk Backend Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="RepoAsk"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# LLM & AI Engine (Optional - Defaults to local AST Code Intelligence Engine when empty)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Model Settings
DEFAULT_MODEL="gemini-2.0-flash"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Security & Limits
MAX_REPO_SIZE_MB=150
MAX_FILE_SIZE_KB=400
MAX_CHUNKS_PER_QUERY=6

# CORS Allowed Origins (Comma-separated in production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]
